{
    "name": "primal-ruin",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "standalone": "rolldown src/main.js --format iife --file standalone.js --platform browser --name PrimalRuin",
        "play": "node scripts/play-standalone.mjs",
        "preview": "vite preview",
        "cards:import": "node scripts/import-cards.mjs",
        "cards:coverage": "node scripts/card-effect-coverage.mjs",
